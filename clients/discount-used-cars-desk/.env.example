# Vega's sale desk. Copy to .env.local for local work; production values live in the host.
#
# Leave Supabase unset to run the desk on the in-memory preview mock (local only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs capture and signing tokens (HMAC-SHA256). Long random string.
ADMIN_SESSION_SECRET=
# Lets the PDF route's headless browser load the internal render page.
INTERNAL_RENDER_TOKEN=
# Local PDF rendering only: path to a Chrome/Chromium binary.
CHROME_PATH=

# ── Dealer facts (the owner supplies these; nothing is invented) ──
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_DEALER_LEGAL_NAME=
# Defaults come from the TxDMV licence record (P113248, Harris). Override only if they change.
NEXT_PUBLIC_DEALER_LICENSE=
NEXT_PUBLIC_DEALER_COUNTY=
NEXT_PUBLIC_DEALER_DOC_FEE=
NEXT_PUBLIC_DEALER_SIGNER_NAME=
NEXT_PUBLIC_DEALER_SIGNER_TITLE=
NEXT_PUBLIC_DEALER_EMAIL=
# Confirm or override the public-listing values:
NEXT_PUBLIC_DEALER_PHONE=
NEXT_PUBLIC_DEALER_STREET=
NEXT_PUBLIC_DEALER_CITY=
NEXT_PUBLIC_DEALER_STATE=
NEXT_PUBLIC_DEALER_ZIP=
NEXT_PUBLIC_DEALER_TIME_ZONE=
NEXT_PUBLIC_SALVAGE_DEALER_LICENSE=
# Payment destinations: leave empty for "not offered". Never a default.
NEXT_PUBLIC_DEALER_ZELLE=
NEXT_PUBLIC_DEALER_CASH_APP=
NEXT_PUBLIC_DEALER_APPLE_PAY=
NEXT_PUBLIC_DEALER_PAYPAL=

# ── SMS for signing texts (off until a provider and campaign are registered) ──
PAPERWORK_TEXTS_ENABLED=false
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Demos only: allow filing while dealer facts are unset (documents still print "Not set").
DESK_ALLOW_UNSET_FACTS=false
