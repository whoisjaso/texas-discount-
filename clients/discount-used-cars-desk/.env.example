# Discount Used Cars and Trucks sale desk. Copy to .env.local for local work; production values live in the host.
#
# Leave Supabase unset to run the desk on the in-memory preview mock (local only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Signs capture and signing tokens (HMAC-SHA256). Long random string.
ADMIN_SESSION_SECRET=
# Lets the PDF route's headless browser load the internal render page.
INTERNAL_RENDER_TOKEN=
# Local PDF rendering only: path to a Chrome/Chromium binary.
CHROME_PATH=

# ── The desk's own address (links only, never printed) ──
# Where signing texts, capture QR codes, recovery and invite links point.
# Recommended value in production: https://desk.discountusedcarsandtrucks.com
# (owner's instruction 10/01/2026). Leave it empty locally so links stay on
# http://localhost:5190. Never printed on a document: paper prints the public
# website below. Filing is refused ("Desk address") until it is set.
NEXT_PUBLIC_SITE_URL=

# ── Dealer facts (the owner supplies these; nothing is invented) ──
# The public website, printed on documents (letterhead, bill of sale, Buyer's
# Guide). Defaults to www.discountusedcarsandtrucks.com (OWNER: billboard
# artwork and texts, 10/01/2026). Override only if it changes.
NEXT_PUBLIC_DEALER_WEBSITE=
NEXT_PUBLIC_DEALER_DOC_FEE=
# The late-handling fee on the Vehicle Responsibility Acknowledgment, in
# dollars, if the filing comes back to the dealer. Not supplied: until it is,
# that sheet prints [Not set: late-handling fee] and cannot be filed.
NEXT_PUBLIC_DEALER_LATE_HANDLING_FEE=
# The mailboxes customers receive mail from (documents, support). Not
# supplied: until they are set and verified in Resend, mail through Resend is
# recorded as not configured and never sent. Nothing is built from the
# website's domain.
RESEND_FROM_EMAIL=
SUPPORT_FROM_EMAIL=
# Legacy rental agreements only. Sale documents print the FILING member's own
# onboarding name beside the dealer line, as "<legal name> (First Last)"; it is
# entered at /admin/account/onboarding, never here.
NEXT_PUBLIC_DEALER_SIGNER_NAME=
NEXT_PUBLIC_DEALER_SIGNER_TITLE=
NEXT_PUBLIC_DEALER_OWNER=
NEXT_PUBLIC_DEALER_EMAIL=
# Defaults come from the TxDMV licence record (Discount Used Cars and Trucks, LLC;
# GDN P145000, expires 09/30/2027; Harris). Override only if they change.
NEXT_PUBLIC_DEALER_LEGAL_NAME=
NEXT_PUBLIC_DEALER_LICENSE=
NEXT_PUBLIC_DEALER_COUNTY=
# Override only if they change. The phone, (713) 900-5050, was confirmed by the
# owner 10/01/2026; the TxDMV record lists (713) 203-3890, which is not printed.
NEXT_PUBLIC_DEALER_PHONE=
NEXT_PUBLIC_DEALER_STREET=
NEXT_PUBLIC_DEALER_CITY=
NEXT_PUBLIC_DEALER_STATE=
NEXT_PUBLIC_DEALER_ZIP=
NEXT_PUBLIC_DEALER_TIME_ZONE=
# Only if the dealer holds a Texas salvage vehicle dealer licence.
NEXT_PUBLIC_SALVAGE_DEALER_LICENSE=
# Payment destinations: leave empty for "not offered". Never a default.
NEXT_PUBLIC_DEALER_ZELLE=
NEXT_PUBLIC_DEALER_CASH_APP=
NEXT_PUBLIC_DEALER_APPLE_PAY=
NEXT_PUBLIC_DEALER_PAYPAL=

# ── Brand (optional overrides; defaults are the files in public/brand/) ──
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_LOGO_REVERSE=
NEXT_PUBLIC_BRAND_MARK=
NEXT_PUBLIC_BRAND_LOGO_INK=
NEXT_PUBLIC_BRAND_MARK_INK=

# ── SMS for signing texts (off until a provider and campaign are registered) ──
PAPERWORK_TEXTS_ENABLED=false
TELNYX_API_KEY=
TELNYX_PHONE_NUMBER=

# Demos only: allow filing while dealer facts are unset (documents still print "Not set").
DESK_ALLOW_UNSET_FACTS=false
# Local preview only (ignored in production): give the preview session a team
# member to onboard. "fresh" is cleared to sign, "fresh-cannot-sign" is not,
# and "fresh-temporary-password" is "fresh" still on the temporary password an
# approval issues (onboarding starts with Choose A Password). All start with no
# name and no signature. Leave empty for today's preview.
DESK_PREVIEW_MEMBER=
