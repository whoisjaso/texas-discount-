# Optional: POST endpoint that receives lead/quote/credit-application JSON.
# Leave empty to keep leads in the browser (demo mode) until the admin dashboard is wired.
VITE_LEADS_ENDPOINT=

# Optional: the sale desk's URL (e.g. https://desk.example.com). When set, the menu
# shows an Admin link to its staff sign-in; left empty, the link is hidden.
VITE_DESK_URL=
